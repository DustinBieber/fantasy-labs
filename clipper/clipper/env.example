# Clipper secrets. Lives at ~/sandbox-data/clipper/.env and is never committed.

# Claude, for picking clips (ai.tier budget/standard/premium). Leave empty to run free heuristics.
# Get a key at https://platform.claude.com/ (Settings > API keys).
ANTHROPIC_API_KEY=

# Dashboard login (HTTP basic auth). `clipper init` generates a password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Public HTTPS address of this Mac mini, e.g. https://mac-mini.your-tailnet.ts.net:8443 (Tailscale Funnel).
# Creators open connect links and OAuth redirects land here. Overrides publish.public_base_url.
PUBLIC_BASE_URL=

# Encrypts creators' OAuth tokens. Leave empty to auto-generate one in the data dir.
CLIPPER_SECRET_KEY=

# --- Posting apps (all free to create; see sandbox/README.md) ---
# Google Cloud console > YouTube Data API v3 > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# developers.tiktok.com > your app > Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# developers.facebook.com > your app > Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
