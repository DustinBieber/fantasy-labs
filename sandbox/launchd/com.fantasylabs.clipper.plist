<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: sandbox.sh native-install fills in __VENV__, __DATA__ and __FFBIN__ and installs it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fantasylabs.clipper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/clipper</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLIPPER_DATA</key><string>__DATA__/clipper</string>
    <key>PATH</key><string>__FFBIN__:__VENV__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>__DATA__/clipper</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>__DATA__/clipper/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__DATA__/clipper/logs/launchd.err.log</string>
</dict>
</plist>
