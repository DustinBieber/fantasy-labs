# Copy to .env (start.sh does this for you on first run). .env is never committed.

# Optional. The Odds API key for multi-book NFL consensus (free tier: 500 credits/month).
# Without it, fair prices come from lines you enter by hand, then ESPN's single book.
ODDS_API_KEY=

# Web server. 0.0.0.0 lets your phone and MacBook reach the Mac Mini on the same Wi-Fi.
APP_HOST=0.0.0.0
APP_PORT=8100

# Storage. Default is data/kalshi_edge.db (SQLite). To move to Postgres later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kalshi_edge
DATABASE_URL=

# Public Kalshi market data needs no login. Kalshi's recommended host. If it ever fails, https://api.elections.kalshi.com/trade-api/v2 is also supported.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2

# Background data pulls. Set to false to run the dashboard without polling.
SCHEDULER_ENABLED=true
HTTP_TIMEOUT_S=20

# Password for the dashboard (any username). REQUIRED before the AI trader can go live, so nobody else on
# your Wi-Fi can open the app and flip it to real money. Use a long one; your browser can remember it.
APP_PASSWORD=

# AI trader, live mode only. Leave blank for paper trading. Create the key at kalshi.com -> Account &
# security -> API Keys. Kalshi shows the private key ONCE: save it as a file on the Mac Mini (for example
# ~/.kalshi/kalshi-edge.pem, then run: chmod 600 ~/.kalshi/kalshi-edge.pem). Never paste it into a chat,
# email, or this file. Only the file path goes here. This is an API key, not your Kalshi password; the app
# never asks for your password and can't move money in or out of your account.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Phone alerts through Telegram (fills, stops, daily summary, parlay tickets). In Telegram, message
# @BotFather -> /newbot to get the token; then message your bot once and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 2 (not used yet): LLM news summaries.
ANTHROPIC_API_KEY=
