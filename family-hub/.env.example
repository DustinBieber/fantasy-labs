# Copy to .env (or set in your host's environment). Only FAMILY_HUB_SECRET_KEY is strongly recommended;
# everything else has a working default.

# Public URL people use to reach the hub. Needed for Google sign-in redirects and webhook URLs.
FAMILY_HUB_BASE_URL=https://hub.example.com

# Encrypts stored OAuth tokens and passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, one is generated into .family_hub_secret on first run. Losing it means reconnecting integrations.
FAMILY_HUB_SECRET_KEY=

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db).
FAMILY_HUB_DATABASE_URL=sqlite:///./family_hub.db

# Google Cloud OAuth client (Web application). Authorized redirect URI must be
#   ${FAMILY_HUB_BASE_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background jobs (allowance, door checks, calendar sync, daily digest). 1 = on.
FAMILY_HUB_SCHEDULER=1
FAMILY_HUB_SCHEDULER_INTERVAL=60
