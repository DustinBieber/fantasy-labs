# Most people never edit this: use the dashboard's Setup tab instead (values saved there live in the
# database; anything set here wins). docs/SETUP.md walks through each one.
# Any connector left blank serves sample data (DEMO_MODE=true) so everything stays usable.

# --- app ---------------------------------------------------------------------
DATABASE_URL=sqlite:///opshub.db          # postgresql+psycopg://user:pass@host/db in production
DEMO_MODE=true
BUSINESS_TIMEZONE=Pacific/Honolulu        # deadlines and daily jobs run on this clock
OPSHUB_USER=ops
OPSHUB_PASSWORD=                          # set this before exposing the app beyond localhost
OPSHUB_SCHEDULER=on                       # background syncs + daily jobs while `serve` runs
# OPSHUB_PUBLIC_URL=https://ops.example.com  # if the dashboard is reached through a tunnel/domain (OAuth redirects)
SYNC_INTERVAL_MINUTES=15                  # default for every system (0 turns background syncs off)
# SYNC_INTERVALS={"shopify": 5, "extensiv": 5, "gmail": 5, "lightspeed": 10}   # per-system minutes (defaults shown)
# REPORTS_INTERVAL_MINUTES=15             # republish the calendar and Sheets report tabs at most this often
# OPSHUB_READ_TOKEN=                      # read-only API key for Muse/ChatGPT/Gemini/Sheets (or Setup > Create a new key)
DIGEST_TIME=07:00
MUSE_EXPORT_TIME=06:00
DIGEST_CHANNELS=google_chat,telegram,gmail
BACKUP_TIME=02:30
# BACKUP_DIR=backups                      # e.g. a Google Drive for desktop folder for off-site copies
# BACKUP_KEEP=14

# --- watch rules (defaults shown) ----------------------------------------------
# DEADLINE_WARN_HOURS=72
# DEADLINE_URGENT_HOURS=24
# ORDER_STALE_DAYS=3
# PRIORITY_UNALLOCATED_HOURS=12
# SHIPMENT_STALE_DAYS=4
# EXPIRY_WARN_DAYS=45
# LOW_STOCK_DAYS=14
# SELL_THROUGH_DAYS=30
# STANDING_ORDER_LOOKAHEAD_DAYS=10
# LOT_POLICY=fefo                         # fefo (earliest best-by first) or fifo (receipt date)
# BILLING_TOLERANCE=0.01
# NOTE_KEYWORDS=urgent,rush,asap,fragile,hold,cancel,...
# DEADLINE_KEYS=need by,delivery date,ship by,...
# ALERT_ROUTES={"urgent": ["google_chat", "telegram", "whatsapp"], "warn": ["google_chat"], "info": []}

# --- Google (one login: Sheets, Drive, Gmail, Calendar, RQ files, Muse) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=             # set by `python -m opshub google-login` (stored in the DB)
# GOOGLE_SERVICE_ACCOUNT_JSON=            # Workspace alternative: path to a key file
# GOOGLE_DELEGATED_USER=                  # with a service account: mailbox to act as
GOOGLE_SHEETS_MASTER_ID=
GOOGLE_SHEETS_REPORT_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=
GMAIL_QUERY=newer_than:14d -in:chats -in:sent
GMAIL_TO=
GOOGLE_CHAT_WEBHOOK_URL=

# --- Shopify ---------------------------------------------------------------------
SHOPIFY_SHOP=                             # yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_SALES_LOCATION_ID=gid://shopify/Location/123
# SHOPIFY_BACKFILL_DAYS=90
# SHOPIFY_IMPORT_FOLDER_ID=               # export files until the API token is in (set by Setup)
# SHOPIFY_IMPORT_GMAIL_QUERY=

# --- Lightspeed Retail (R-Series) -------------------------------------------------
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
LIGHTSPEED_ACCOUNT_ID=                    # printed by `python -m opshub lightspeed-login`
# LIGHTSPEED_REFRESH_TOKEN=               # stored in the DB by lightspeed-login; rotates automatically
# LIGHTSPEED_SKU_FIELD=customSku
# LIGHTSPEED_TOKEN_URL=https://cloud.lightspeedapp.com/auth/oauth/token
# LIGHTSPEED_AUTHORIZE_URL=https://cloud.lightspeedapp.com/auth/oauth/authorize
# LIGHTSPEED_BACKFILL_DAYS=90
# LIGHTSPEED_IMPORT_FOLDER_ID=            # export files until the API is connected (set by Setup)
# LIGHTSPEED_IMPORT_GMAIL_QUERY=
# LIGHTSPEED_DEFAULT_SHOP=                # for exports without a shop column

# --- Extensiv 3PL Warehouse Manager (issued by the 3PL) ------------------------------
EXTENSIV_CLIENT_ID=
EXTENSIV_CLIENT_SECRET=
EXTENSIV_USER_LOGIN_ID=
EXTENSIV_CUSTOMER_ID=
EXTENSIV_FACILITY_ID=
# EXTENSIV_TPL_KEY=
EXTENSIV_VENDOR_NAME=Riverside 3PL        # must match the vendor on the RateCard tab
# EXTENSIV_ACTIVITY_CODES={"order": "PICK-ORD", "extra_unit": "PICK-UNIT", "receipt_pallet": "RCV-PLT", "storage_pallet": "STOR-PLT", "hazmat_order": "HAZ-HNDL"}
# EXTENSIV_BASE_URL=https://secure-wms.com
# EXTENSIV_IMPORT_FOLDER_ID=              # portal exports until the 3PL issues API access (set by Setup)
# EXTENSIV_IMPORT_GMAIL_QUERY=

# --- iQmetrix RQ (report files; no API) -----------------------------------------------
RQ_DRIVE_FOLDER_ID=
RQ_GMAIL_QUERY=
# RQ_DEFAULT_STORE=                       # for reports without a store column

# --- Muse AI (daily Drive handoff) ------------------------------------------------------
MUSE_DRIVE_OUTBOX_FOLDER_ID=              # Ops Hub -> Muse
MUSE_DRIVE_INBOX_FOLDER_ID=               # Muse -> Ops Hub
# MUSE_LOCAL_DIR=handoff                  # where the export goes until Drive is connected

# --- Telegram -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                         # from `python -m opshub telegram-chats`
# TELEGRAM_STAFF_CHAT_IDS=
# TELEGRAM_FREIGHT_CHAT_IDS=

# --- WhatsApp Cloud API ----------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=                              # staff numbers for alerts, comma-separated
WHATSAPP_TEMPLATE=                        # approved template with one body variable
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=                    # for the /webhooks/whatsapp handshake
WHATSAPP_APP_SECRET=                      # verifies inbound webhook signatures
# WHATSAPP_STAFF_NUMBERS=
# WHATSAPP_FREIGHT_NUMBERS=

# --- AI (tried in AI_PROVIDERS order; rules only if none set) -------------------------------
# AI_PROVIDERS=claude,gemini,openai
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
