# Copy to .env and fill in what you have. Any connector left blank serves sample data
# (DEMO_MODE=true) so the dashboard stays usable while integrations come online.

# --- app ---------------------------------------------------------------------
DATABASE_URL=sqlite:///opshub.db          # postgresql+psycopg://user:pass@host/db in production
DEMO_MODE=true
BUSINESS_TIMEZONE=America/New_York        # "need by Nov 3" = end of Nov 3 here
OPSHUB_USER=ops
OPSHUB_PASSWORD=                          # set this before exposing the app beyond localhost
SYNC_INTERVAL_MINUTES=0                   # >0 runs a background sync while the server is up

# --- watch rules (defaults shown) ----------------------------------------------
# DEADLINE_WARN_HOURS=72
# DEADLINE_URGENT_HOURS=24
# ORDER_STALE_DAYS=3
# PRIORITY_UNALLOCATED_HOURS=12
# SHIPMENT_STALE_DAYS=4
# EXPIRY_WARN_DAYS=45
# LOW_STOCK_DAYS=14
# SELL_THROUGH_DAYS=30
# STANDING_ORDER_LOOKAHEAD_DAYS=10
# LOT_POLICY=fefo                         # fefo (earliest best-by first) or fifo (receipt date)
# BILLING_TOLERANCE=0.01
# NOTE_KEYWORDS=urgent,rush,asap,fragile,hold,cancel,...
# DEADLINE_KEYS=need by,delivery date,ship by,...
# ALERT_ROUTES={"urgent": ["google_chat", "telegram", "whatsapp"], "warn": ["google_chat"], "info": []}
# DIGEST_CHANNELS=google_chat,telegram

# --- Shopify (custom app: read_orders, read_inventory, read_locations, read_fulfillments) ---
SHOPIFY_SHOP=                             # yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_SALES_LOCATION_ID=gid://shopify/Location/123   # where online sales count against stock
# SHOPIFY_BACKFILL_DAYS=90

# --- Extensiv 3PL Warehouse Manager (credentials issued by the 3PL) -------------
EXTENSIV_CLIENT_ID=
EXTENSIV_CLIENT_SECRET=
EXTENSIV_USER_LOGIN_ID=
EXTENSIV_CUSTOMER_ID=
# EXTENSIV_VENDOR_NAME=Riverside 3PL      # must match the vendor name on the rate card

# --- Lightspeed Retail (R-Series) ------------------------------------------------
LIGHTSPEED_ACCOUNT_ID=
LIGHTSPEED_ACCESS_TOKEN=

# --- iQmetrix RQ (Data Connect) --------------------------------------------------
RQ_DATACONNECT_URL=
RQ_COMPANY_ID=
RQ_API_TOKEN=

# --- Google Workspace --------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=              # path to the service-account key file
GOOGLE_SHEETS_MASTER_ID=                  # the ops master-data workbook
GMAIL_DELEGATED_USER=                     # mailbox to read, e.g. ops@yourco.com
GOOGLE_DRIVE_FOLDER_ID=                   # folder the 3PL drops invoices into
GOOGLE_CALENDAR_ID=
GOOGLE_CHAT_WEBHOOK_URL=                  # Space > Apps & integrations > Webhooks

# --- Telegram ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Cloud API ----------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=                              # comma-separated numbers, international format
# WHATSAPP_TEMPLATE=ops_alert             # approved template with one body variable
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_GRAPH_VERSION=v23.0

# --- AI (tried in AI_PROVIDERS order; rules-only if none set) ---------------------------
# AI_PROVIDERS=claude,gemini,openai
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# --- Muse (not built yet) -----------------------------------------------------------------
MUSE_API_KEY=
